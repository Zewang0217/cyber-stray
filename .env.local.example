# ── 阿里云 OSS ─────────────────────────────────────────────
# bucket 名（建议地域 cn-beijing）
OSS_BUCKET=
# 公网 endpoint，例：oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=
# 地域，例：cn-beijing
OSS_REGION=

# CI 上传专用 RAM（策略仅允许写 releases/ 前缀）
OSS_CI_ACCESS_KEY_ID=
OSS_CI_ACCESS_KEY_SECRET=

# 服务器专用 RAM（releases/ 只读 + backups/ 读写）
OSS_SRV_ACCESS_KEY_ID=
OSS_SRV_ACCESS_KEY_SECRET=

# ── staging 访问控制（Basic Auth）──────────────────────────
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# ── Casdoor 管理后台 ──
CASDOOR_ADMIN_USER=
CASDOOR_ADMIN_PASSWORD=
