{
  "name": "cyber-stray",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:agent": "pnpm --filter @cyber-stray/agent dev",
    "dev:web": "pnpm --filter @cyber-stray/web dev",
    "dev:cp": "pnpm --filter @cyber-stray/control-plane dev",
    "dev:slides": "pnpm --filter @cyber-stray/slides dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "setup:browser": "node scripts/setup-agent-browser.mjs"
  },
  "devDependencies": {
  }
}
