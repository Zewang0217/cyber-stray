# cyber-stray 环境变量名清单（ADR-0008：仓库只存变量名，不存值）
# 生产唯一落点：/opt/cyber-stray/.env（compose env_file 注入；gitignored）。
# 本文件是清单 + 占位，值一律留空或示例。

# 控制面（必填）
CP_SESSION_SECRET=            # ≥32 字节随机串（openssl rand -hex 32）
CP_MASTER_KEY=                # 64 hex（openssl rand -hex 32）
CP_DATA_DIR=                  # 裸进程部署时指数据目录；容器内由 compose 固定为 /data
CP_WEB_ORIGIN=                # 对外 https 域名（浏览器视角）
CP_ADMIN_SUBS=                # 运营管理面板管理员 Casdoor sub（逗号分隔）

# Casdoor OIDC（在 Casdoor 管理界面创建应用后填）
CASDOOR_ISSUER=               # 浏览器与 CP 均可达的 casdoor 地址；域名切换后填 https://auth.<域名>
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=         # 对外回调地址（浏览器视角）；域名切换后填 https://app.<域名>/api/auth/callback

# LLM / 搜索 / 推送（agent worker 用）
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
DASHSCOPE_API_KEY=
FEISHU_WEBHOOK=
LARK_APP_ID=
LARK_APP_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 生图 / 视觉（petgen 管线）
ARK_API_KEY=
# CP_ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
# 视觉质检：缺省回退 ZHIPU_API_KEY + 智谱端点 + glm-4.5v；接 ECNU 等
# OpenAI 兼容端点时配 CP_VISION_BASE_URL / CP_VISION_API_KEY 一行切换
ZHIPU_API_KEY=
# CP_VISION_API_KEY=            # 缺省回退 ZHIPU_API_KEY
# CP_VISION_MODEL=glm-4.5v
# CP_VISION_BASE_URL=           # 缺省智谱 https://open.bigmodel.cn/api/paas/v4
# CP_VISION_THINKING=true       # 基准实测开思考才达产线水位；false 关闭

# 成本护栏 / 运维告警（可选，缺省见 config.ts）
# CP_LLM_BUDGET_ENABLED=true    # 每租户日预算闸总开关（false = 不限）
# CP_LLM_BUDGET_FREE_YUAN=0.5   # free 套餐每日平台 LLM 预算（¥）；0 = 该套餐不限
# CP_LLM_BUDGET_PRO_YUAN=2
# CP_LLM_BUDGET_BYOK_YUAN=2
# CP_OPS_ALERT_WEBHOOK_URL=     # CP 内告警外呼（worker 连败/预算耗尽/首推超时）；空 = 只发租户事件不外呼
# BACKUP_ALERT_WEBHOOK_URL=     # 备份整体失败告警（deploy/backup.sh，随 backup.env 注入）
# OPS_ALERT_WEBHOOK_URL=        # 发布/备份脚本失败告警（deploy/*.sh，须在脚本运行环境注入，非 compose env_file）

# 调度 / 停机（可选，缺省见 packages/control-plane/src/config.ts）
# CP_PORT=8787
# CP_SCHEDULER_INTERVAL_MS=60000
# CP_SCHEDULER_MAX_CONCURRENT=4
# CP_WORKER_TIMEOUT_MS=600000
# CP_SCHEDULER_RETRY_BACKOFF_MS=60000
# CP_SCHEDULER_MAX_RETRIES=2
# CP_SHUTDOWN_BUDGET_MS=90000   # 优雅停机收口预算（compose stop_grace_period 需覆盖）
# CP_PETGEN_MONTHLY_QUOTA=2
# CP_PETGEN_INTERVAL_MS=5000
# CP_MEME_ENABLED=true
