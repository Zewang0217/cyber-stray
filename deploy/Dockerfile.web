# syntax=docker/dockerfile:1
# web 镜像：Next.js standalone 产物 + node 运行时。构建仅在 main 发布流水线执行。
#
# CP_ORIGIN 是构建期变量（next.config.ts 的 rewrites 在构建时内联目标）：
# compose 网络内指向 control-plane 服务名；裸进程部署需覆盖为
# http://127.0.0.1:8787。
FROM node:22-bookworm-slim AS builder
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/
# shared 源码：transpilePackages 构建期直接消费 TS
COPY packages/shared ./packages/shared
COPY packages/web ./packages/web
RUN corepack enable && pnpm install --frozen-lockfile --filter @cyber-stray/web
ARG CP_ORIGIN=http://control-plane:8787
ENV CP_ORIGIN=$CP_ORIGIN
RUN pnpm --filter @cyber-stray/web build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
# standalone 树：Turbopack root 为仓库根，server.js 在 packages/web/ 下
COPY --from=builder /repo/packages/web/.next/standalone ./
COPY --from=builder /repo/packages/web/.next/static ./packages/web/.next/static
COPY --from=builder /repo/packages/web/public ./packages/web/public
EXPOSE 3000
CMD ["node", "packages/web/server.js"]
