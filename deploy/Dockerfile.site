# syntax=docker/dockerfile:1
# 官网镜像（packages/site）——Next.js 静态导出（output: export）产物 out/，
# nginx 纯静态伺服，运行时无 node 进程（与 web 的 standalone 运行时不同：
# 官网零服务端逻辑，静态文件即全部）。
#
# NEXT_PUBLIC_APP_URL 是构建期变量（静态导出把 CTA 地址内联进 HTML）：
# 发布流水线经 build-args 注入对外伴侣端地址；未注入（空值）时回落
# 127.0.0.1:3000（本机联调形态）。
FROM node:22-bookworm-slim AS builder
WORKDIR /repo
# 只拷贝清单 → 锁文件安装（同 Dockerfile.web 模式，利用 layer 缓存）
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/site/package.json packages/site/
# shared 源码：transpilePackages 构建期直接消费 TS 源码
COPY packages/shared ./packages/shared
COPY packages/site ./packages/site
RUN corepack enable && pnpm install --frozen-lockfile --filter @cyber-stray/site
ARG NEXT_PUBLIC_APP_URL=""
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL:-http://127.0.0.1:3000}
RUN pnpm --filter @cyber-stray/site build

FROM nginx:1.27-alpine
COPY deploy/nginx.site.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/packages/site/out /usr/share/nginx/html
EXPOSE 80
