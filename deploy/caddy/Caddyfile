# Ingress for cyber-stray. Ships inside the caddy image (see Dockerfile.caddy) so a
# release never syncs config files onto the server; only the release tag changes.
# Runs with network_mode: host, so every upstream below is reached over loopback.

# Cloudflare stands in front of these domains (orange cloud): visitor TLS ends at
# Cloudflare's edge, which then pulls the origin over http:// or https://.
# Serving real content on :80 is therefore mandatory - Caddy's automatic
# HTTP-to-HTTPS redirect would answer a Flexible-mode origin pull with a 308 and
# the site would be unreachable. Redirects are disabled globally below and every
# proxied domain is bound on both ports; ACME still runs and still renews.
# Cloudflare's SSL mode is an ops choice and is deliberately not encoded here:
# Flexible works as-is, Full works through the automatic HTTPS below, and Full
# (strict) additionally wants a Cloudflare Origin CA certificate in Caddy's store.

{
	auto_https disable_redirects
}

# Product entry: the companion app, which serves the landing page to anonymous
# visitors and the home page to signed-in ones.
(app_entry) {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			# Product pages hold SSE streams open; never buffer them.
			flush_interval -1
		}
	}
}

# Identity service (Casdoor). Its own block because prod and staging share one
# issuer and one account database while keeping independent OIDC clients.
(identity_entry) {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

# Staging entry. Real tenant data lives behind this one, so it is gated by HTTP
# Basic Auth whose credentials are injected from the infra env file at container
# start. The gate covers the whole host, health probe included.
(staging_entry) {
	basic_auth {
		{$STAGING_AUTH_USER} {$STAGING_AUTH_HASH}
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
		}
	}
}

# Temporary domains. Both ports in one block: :443 from automatic HTTPS, :80 for
# Cloudflare's origin pull. These names go away once kleinbottle.top is filed and
# its DNS is ready; the blocks at the bottom replace them unchanged.
cs.caca.qzz.io, http://cs.caca.qzz.io {
	import app_entry
}

csauth.caca.qzz.io, http://csauth.caca.qzz.io {
	import identity_entry
}

csdev.caca.qzz.io, http://csdev.caca.qzz.io {
	import staging_entry
}

# Bare-IP access for the filing window. Plain HTTP on purpose: no certificate
# exists for an IP literal, and Cloudflare is not in the path.
http://117.72.100.212 {
	import app_entry
}

# Post-filing target state: uncomment both blocks and delete the caca.qzz.io
# blocks above once kleinbottle.top resolves here. The apex serves the
