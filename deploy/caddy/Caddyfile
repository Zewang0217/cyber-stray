# Ingress for cyber-stray. Ships inside the caddy image (see Dockerfile.caddy) so a
# release never syncs config files onto the server; only the release tag changes.
# Runs with network_mode: host, so every upstream below is reached over loopback.

# Direct entry with real certificates: the three hostnames resolve to the server's
# public IP, Caddy terminates TLS itself and obtains/renews certificates over ACME
# (:80 must stay reachable for the HTTP challenge). Plain HTTP answers with
# Caddy's automatic redirect to HTTPS.

# Product entry: the companion app, which serves the landing page to anonymous
# visitors and the home page to signed-in ones.
(app_entry) {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			# Product pages hold SSE streams open; never buffer them.
			flush_interval -1
		}
	}
}

# Identity service (Casdoor). Its own block because prod and staging share one
# issuer and one account database while keeping independent OIDC clients.
(identity_entry) {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

# Staging entry. Real tenant data lives behind this one, so it is gated by HTTP
# Basic Auth whose credentials are injected from the infra env file at container
# start. The gate covers the whole host, health probe included.
(staging_entry) {
	basic_auth {
		{$STAGING_AUTH_USER} {$STAGING_AUTH_HASH}
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
		}
	}
}

kleinbottle.top {
	import app_entry
}

auth.kleinbottle.top {
	import identity_entry
}

csdev.kleinbottle.top {
	import staging_entry
}
