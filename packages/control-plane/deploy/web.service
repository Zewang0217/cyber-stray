# web systemd unit（生产部署：VPS）
#
# 产物：CI 构建的 Next.js standalone（web-standalone.tar.gz，含 server.js +
# 静态资源）——产机零构建。node 运行时即可。
#
# 安装:
#   sudo mkdir -p /opt/cyber-stray-web
#   sudo tar -xzf web-standalone.tar.gz -C /opt/cyber-stray-web
#   # → /opt/cyber-stray-web/app/packages/web/server.js（ExecStart 指向此处）
#   sudo cp packages/control-plane/deploy/web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now web
#
# 验证: systemctl status web && curl -I http://localhost:3000

[Unit]
Description=Cyber Stray web dashboard (Next.js standalone)
Documentation=https://github.com/Zewang0217/cyber-stray
After=network.target control-plane.service
Wants=control-plane.service

[Service]
Type=simple
WorkingDirectory=/opt/cyber-stray-web
# CI 产物解包后 server.js 位于 app/packages/web/server.js（完整 standalone 树）
ExecStart=/usr/bin/node app/packages/web/server.js
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# S12 崩溃自恢复
Restart=always
RestartSec=5
TimeoutStopSec=20
MemoryHigh=1G
MemoryMax=1.5G

[Install]
WantedBy=multi-user.target
