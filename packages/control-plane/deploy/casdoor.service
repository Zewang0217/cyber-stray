# Casdoor systemd unit（生产部署：VPS）
#
# 安装:
#   sudo useradd -r -s /usr/sbin/nologin casdoor
#   sudo mkdir -p /opt/casdoor && sudo cp -r ~/casdoor/{casdoor,conf} /opt/casdoor/
#   sudo chown -R casdoor:casdoor /opt/casdoor
#   sudo cp packages/control-plane/deploy/casdoor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now casdoor
#
# 验证: systemctl status casdoor && curl http://localhost:8000/.well-known/openid-configuration

[Unit]
Description=Casdoor - OIDC provider for cyber-stray control plane
Documentation=https://casdoor.org
After=network.target

[Service]
Type=simple
User=casdoor
Group=casdoor
WorkingDirectory=/opt/casdoor
ExecStart=/opt/casdoor/casdoor
Restart=on-failure
RestartSec=5
# SQLite 单文件账号库，无需网络依赖
Environment=GIN_MODE=release

[Install]
WantedBy=multi-user.target
